# Environment Configuration for ArdurTrueAlign
# Copy this to .env and update with your actual values

# Security
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=home.aurdurtechnology.com,www.home.aurdurtechnology.com

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=ardurTrueAlign
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Notification Settings
ENABLE_BROWSER_NOTIFICATIONS=True
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_SMS_NOTIFICATIONS=False
NOTIFICATION_POLLING_INTERVAL=30

# Office Configuration
OFFICE_IPS=116.75.62.90,192.168.1.0/24
